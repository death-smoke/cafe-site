# Файл-шаблон: при старте контейнера официальный образ nginx прогоняет его через envsubst
# и кладёт результат в /etc/nginx/conf.d/default.conf. Все ${...} берутся из переменных окружения (.env).
resolver ${NGINX_RESOLVER} valid=5s ipv6=off;

server {
    listen ${NGINX_LISTEN_PORT};
    server_name ${NGINX_SERVER_NAME};
    client_max_body_size ${MAX_UPLOAD_MB}m;

    location = /swagger {
        return 302 /api/swagger/index.html;
    }

    # API -> HAProxy -> backend-реплики
    location /api/ {
        set $api_upstream http://${HAPROXY_HOST}:${HAPROXY_PORT};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Сайт -> frontend-реплики
    location / {
        set $front_upstream http://${FRONTEND_HOST}:${FRONTEND_PORT};
        proxy_pass $front_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
